CompileFlags:
  Add:
    - -Iwindows/flutter/ephemeral/cpp_client_wrapper/include
    - -Iwindows/flutter/ephemeral
    - -Iwindows
    - -std=c++17
    - -DUNICODE
    - -D_UNICODE

---
If:
  PathMatch: .*linux.*
Diagnostics:
  Suppress: ["*"]

---
If:
  PathMatch: .*windows.*
Diagnostics:
  Suppress:
    - -Wvexing-parse

